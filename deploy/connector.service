[Unit]
Description=Connector MCP gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=connector
Group=http
ExecStart=/opt/connector/connector-gateway
EnvironmentFile=/etc/connector.env
StateDirectory=connector
StateDirectoryMode=0700
RuntimeDirectory=connector
RuntimeDirectoryMode=0710
UMask=0077
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/connector /run/connector

[Install]
WantedBy=multi-user.target
